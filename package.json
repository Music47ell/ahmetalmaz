{
	"name": "ahmet-almaz",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro telemetry disable && astro dev",
		"start": "astro telemetry disable && astro dev",
		"build": "astro telemetry disable && bun run generate:og && astro build",
		"deploy": "bun run build && wrangler deploy --config dist/server/wrangler.json",
		"deploy:dry-run": "bun run build && wrangler deploy --dry-run --config dist/server/wrangler.json",
		"preview": "astro telemetry disable && astro preview",
		"astro": "astro",
		"check": "astro check",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"update": "bunx npm-check-updates --format group --interactive",
		"generate:types": "wrangler types",
		"generate:og": "bun src/scripts/generate-og.ts"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/cloudflare": "14.2.3",
		"@astrojs/markdown-remark": "7.2.4",
		"@astrojs/mdx": "7.0.7",
		"@astrojs/react": "6.0.4",
		"@astrojs/rss": "^4.0.19",
		"@libsql/client": "^0.17.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/markdown-it": "^14.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"astro": "7.2.4",
		"astro-expressive-code": "^0.44.1",
		"dotenv": "^17.4.2",
		"fast-xml-parser": "^5.11.0",
		"globe.gl": "^2.46.2",
		"kleur": "^4.1.5",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"string-width": "^8.2.2",
		"tailwindcss": "^4.3.3",
		"three": "^0.185.1",
		"typescript": "^7.0.2",
		"unist-util-visit": "^5.1.0",
		"wrangler": "^4.125.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@resvg/resvg-js": "^2.6.2",
		"@types/bun": "^1.4.0",
		"@types/sanitize-html": "^2.16.1",
		"@types/three": "^0.185.4",
		"@types/unist": "^3.0.3",
		"gray-matter": "^4.0.3",
		"markdown-it": "^15.0.0",
		"sanitize-html": "^2.17.7",
		"satori": "^0.33.3"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	]
}
